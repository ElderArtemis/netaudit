# Copia este fichero a .env y ajusta los valores.
# .env esta en .gitignore: NUNCA lo subas al repositorio.

DATABASE_URL=postgresql+asyncpg://netaudit:netaudit@postgres:5432/netaudit
REDIS_URL=redis://redis:6379/0
APP_ENV=production

# Genera uno propio, no dejes este valor:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SECRET_KEY=cambiame-genera-uno-propio

# Paquetes por segundo de masscan (max. recomendado 100000)
MASSCAN_RATE=10000

# Plantilla de timing de nmap (-T0 a -T5)
NMAP_TIMING=4

# Prefijo si sirves la app tras un reverse proxy en un subpath
ROOT_PATH=
